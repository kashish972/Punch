# Upstash QStash — https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts the Keka token before it is handed to QStash.
TOKEN_ENC_KEY=

# Public URL QStash calls back. On Vercel this is inferred from
# VERCEL_PROJECT_PRODUCTION_URL; set it only to override (or for local tunnels).
# AUTO_CLOCKOUT_BASE_URL=https://your-app.vercel.app
